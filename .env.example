# ============================================
# Vercel → Project → Settings → Environment Variables
# Add on: Production, Preview, Development
# ============================================

# Public site URL — on Vercel use https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Same-origin API (keep /api on Vercel)
NEXT_PUBLIC_API_URL=/api

# Auth (use a long random secret on Vercel)
JWT_SECRET=change_this_to_a_long_random_secret_key

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://tracking-4e060-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=tracking-4e060

# Required on Vercel (JSON file path does not work there)
# Copy from serviceAccountKey.json → client_email and private_key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tracking-4e060.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_FROM_FIREBASE\n-----END PRIVATE KEY-----\n"

# Local only — do not add on Vercel
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Old backend vars (not needed on Vercel)
PORT=5000
FRONTEND_URL=http://localhost:3000,http://localhost:3002
